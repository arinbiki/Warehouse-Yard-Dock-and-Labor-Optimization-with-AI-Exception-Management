# ==============================================================================
# Warehouse, Yard, Dock, and Labor Optimization with AI Exception Management
# Environment Configuration Template
# ==============================================================================

# Database Persistence
OPERATIONS_DB=warehouse_operations.db

# n8n Orchestration Layer
N8N_BASE_URL=https://your-n8n-instance.com
N8N_PUBLIC_API_KEY=your_n8n_public_api_key_here
N8N_MCP_URL=https://your-n8n-instance.com/mcp-server/http
N8N_MCP_TOKEN=your_n8n_mcp_token_here

# Dify LLM & Cognitive Workflow Automation Layer
DIFY_BASE_URL=http://localhost:3000
DIFY_API_KEY=your_dify_api_key_here

# Local Ollama AI Server (Qwen 3B / 2.5)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

# High-Speed Cloud Fallback (Groq Qwen 27B)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.6-27b

# Remote Server Access
SSH_HOST=your_host_ip
SSH_USER=ubuntu
SSH_PASS=your_ssh_password_here

# Python Decision Engine Service
DECISION_ENGINE_HOST=0.0.0.0
DECISION_ENGINE_PORT=8090
