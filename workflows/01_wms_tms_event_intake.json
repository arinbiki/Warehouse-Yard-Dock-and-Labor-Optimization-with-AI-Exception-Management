{
  "name": "01 - WMS-TMS Event Intake",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "warehouse-event-intake",
        "responseMode": "onReceived",
        "responseData": "allEntries"
      },
      "id": "webhook_01",
      "name": "Webhook Intake",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [
        200,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nreturn items.map(item => ({\n  json: {\n    event_id: item.json.event_id || 'EVT-' + Date.now(),\n    event_type: item.json.event_type || 'GATE_CHECK_IN',\n    timestamp: new Date().toISOString(),\n    payload: item.json,\n    status: 'NORMALIZED'\n  }\n}));"
      },
      "id": "node_01_1",
      "name": "Validate & Normalize Event",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        450,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "return [{ json: { dispatch_status: 'SUCCESS', dependent_workflows: ['DOCK_SCHEDULE', 'DETENTION_MONITOR'] } }];"
      },
      "id": "node_01_2",
      "name": "Dispatch Dependent Triggers",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        700,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Log workflow execution audit\nconst res = $input.all();\nreturn res.map(r => ({ json: { ...r.json, _audit: { workflow: '01 - WMS-TMS Event Intake', processed_at: new Date().toISOString() } } }));"
      },
      "id": "audit_01",
      "name": "Operational Audit Log",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        950,
        300
      ]
    }
  ],
  "connections": {
    "Webhook Intake": {
      "main": [
        [
          {
            "node": "Validate & Normalize Event",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Validate & Normalize Event": {
      "main": [
        [
          {
            "node": "Dispatch Dependent Triggers",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Dispatch Dependent Triggers": {
      "main": [
        [
          {
            "node": "Operational Audit Log",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "templateCredsSetupCompleted": true,
    "description": "Receives real-time WMS, TMS, Gate and IoT events, normalizes payloads, and triggers state updates"
  }
}